# ── Ambiente ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
composer.lock

# ── Dependências ──────────────────────────────────────────────────────────────
/vendor/

# ── Storage gerado em runtime ─────────────────────────────────────────────────
/storage/cache/*
/storage/logs/erros_aplicacao/*
/storage/logs/requisicao/*
/storage/logs/erros_nativos/*
/storage/sessions/*
/storage/uploads/*

# Mantém as pastas no repositório
!/storage/cache/.gitkeep
!/storage/logs/erros_aplicacao/.gitkeep
!/storage/logs/requisicao/.gitkeep
!/storage/logs/erros_nativos/.gitkeep
!/storage/sessions/.gitkeep
!/storage/uploads/.gitkeep

# ── IDEs e SO ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
.phpunit.result.cache

# ── Arquivos de debug que nunca devem ir ao repo ───────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

