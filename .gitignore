# ── Ambiente ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Dependências ──────────────────────────────────────────────────────────────
/vendor/

# ── Storage gerado em runtime ─────────────────────────────────────────────────
/storage/logs/*
/storage/cache/*
/storage/sessions/*
/storage/uploads/*

# Mantém as pastas no repositório
!storage/logs/.gitkeep
!storage/cache/.gitkeep
!storage/sessions/.gitkeep
!storage/uploads/.gitkeep

# ── IDEs e SO ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
