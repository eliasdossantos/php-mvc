# ──────────────────────────────────────────────────────────────────────────────
# Copie para .env e preencha com seus valores.
# NUNCA suba o arquivo .env para o repositório.
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME="Minha Aplicação"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=troque-por-uma-chave-aleatoria-de-32-chars
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=meu_banco
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_LIFETIME=120
SESSION_SECURE=false

# Drivers: smtp | log | dev
MAIL_DRIVER=dev
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Minha Aplicação"
