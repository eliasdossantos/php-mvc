# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copie para .env e preencha os valores reais
# NUNCA comite o arquivo .env no repositório
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplicação ─────────────────────────────────────────────────────────────────
APP_NAME="Minha Aplicação"
APP_URL=http://localhost:8000 # obrigatório em produção; use HTTPS
APP_ENV=local          # local | production
APP_DEBUG=false        # SEMPRE false em produção
APP_KEY=troque-por-uma-chave-aleatoria
APP_TIMEZONE=America/Sao_Paulo

# ── Banco de dados ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app_db
DB_USERNAME=root
DB_PASSWORD=

# ── Sessão ────────────────────────────────────────────────────────────────────
SESSION_LIFETIME=120
SESSION_SECURE=false   # produção força Secure; HTTPS é obrigatório
SESSION_SAME_SITE=Lax  # Strict | Lax | None

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
#
# Configuração do sistema de envio de e-mails.
#
# MAIL_DRIVER:
#   dev  → Não envia o e-mail. Retorna uma URL no payload JSON para
#          visualização/testes durante o desenvolvimento.
#
#   log  → Não envia o e-mail. Registra o conteúdo e as informações
#          da mensagem em storage/logs/mail.log.
#
#   smtp → Envia o e-mail através de um servidor SMTP configurado.
#          Pode utilizar PHPMailer ou uma implementação SMTP nativa.
#
MAIL_DRIVER=dev
#
# Para utilizar um servidor SMTP:
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls    # tls | ssl
#
# Remetente padrão das mensagens:
MAIL_FROM_ADDRESS=noreply@exemplo.com
MAIL_FROM_NAME="Minha Aplicação"

# ── API (/api/v1) ──────────────────────────────────────────────────────────
#
# Timeout padrão (segundos) para chamadas de saída via Core\Api\ApiClient
API_TIMEOUT=30

# Origens autorizadas a consumir a API via CORS, separadas por vírgula.
# Use * apenas em desenvolvimento — nunca em produção com endpoints autenticados.
CORS_ALLOWED_ORIGINS=

# Proxies reversos confiáveis, separados por vírgula; vazio = confiar apenas em REMOTE_ADDR.
TRUSTED_PROXIES=

# ── Integração de CEP ─────────────────────────────────────────────────────────
CEP_PROVIDER=viacep

# ── Gateway de pagamento ──────────────────────────────────────────────────────
# PAYMENT_PROVIDER: null (padrão, sem cobrança real) | mercadopago | asaas
PAYMENT_PROVIDER=null

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
