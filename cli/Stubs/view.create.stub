                <!-- Campo: nome -->
                <div class="form-group">
                    <label for="nome">
                        Nome
                        <span style="color:var(--color-danger)">*</span>
                    </label>

                    <input type="text"
                           id="nome"
                           name="nome"
                           value="<?= e(old('nome')) ?>"
