<!-- Aqui enviamos para o template principal o título da página -->

<?php View::start('title'); ?>

<?= e($title ?? '{{ ModelName }}') ?> | Admin

<?php View::end(); ?>


<!-- Aqui enviamos para o template principal os estilos -->

<?php View::start('styles'); ?>

<?php View::end(); ?>


<!-- Aqui enviamos para o template principal o conteúdo -->

<?php View::start('content'); ?>

<!-- Begin Page Content -->

<div class="container-fluid">

    <div class="page-header">
        <div>
            <h1 class="h3 mb-4 text-gray-800">
                <?= e($title ?? '{{ ModelName }}') ?>
            </h1>
        </div>

        <a href="<?= url('dashboard/{{ routePrefix }}/create') ?>"
           class="btn btn-primary">
            + Novo {{ ModelName }}
        </a>
    </div>

    <?= \Core\View::render('components.alerts'); ?>

    <div class="card">
        <div class="table-wrapper">

            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Criado em</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>

                    <?php if (empty($items['data'] ?? [])): ?>

                        <tr>
                            <td colspan="4" class="text-center text-muted">
                                Nenhum registro encontrado.
                            </td>
                        </tr>

                    <?php else: ?>

                        <?php foreach ($items['data'] as $item): ?>

                            <tr>
                                <td>
                                    <?= e($item->id) ?>
                                </td>

                                <td>
                                    <?= e($item->nome) ?>
                                </td>

                                <td>
                                    <?= dateBR($item->created_at) ?>
                                </td>

                                <td>

                                    <a href="<?= url("dashboard/{{ routePrefix }}/{$item->id}") ?>"
                                       class="btn btn-sm btn-outline">
                                        Ver
                                    </a>

                                    <a href="<?= url("dashboard/{{ routePrefix }}/{$item->id}/edit") ?>"
                                       class="btn btn-sm btn-secondary">
                                        Editar
                                    </a>

                                    <form method="POST"
                                          action="<?= url("dashboard/{{ routePrefix }}/{$item->id}") ?>"
                                          style="display:inline">

                                        <?= csrf_field() ?>
                                        <?= method_field('DELETE') ?>

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                data-confirm="Excluir este {{ ModelName }}?">
                                            Excluir
                                        </button>

                                    </form>

                                </td>
                            </tr>

                        <?php endforeach; ?>

                    <?php endif; ?>

                </tbody>
            </table>

        </div>
    </div>

    <?php
    /**
     * ── CORRIGIDO ──────────────────────────────────────────────────────────
     * Antes esta chamada não tinha "<?=" na frente. \Core\View::render()
     * RETORNA a string, não imprime sozinho — então a paginação nunca
     * aparecia na tela, sem erro nenhum, sem aviso nenhum.
     */
    ?>
    <?= \Core\View::render('components.pagination', ['data' => $items ?? []]); ?>

</div>

<!-- /.container-fluid -->

<?php View::end(); ?>


<!-- Aqui enviamos para o template principal os scripts -->

<?php View::start('scripts'); ?>

<script src="<?= asset('js/demo.js') ?>"></script>

<?php View::end(); ?>
