            <!--
                Se o Model tiver campo de arquivo, adicione enctype="multipart/form-data"
                abaixo — sem isso, $_FILES chega vazio no controller.
                Ex: <form method="POST" action="..." enctype="multipart/form-data">
            -->
            <form method="POST"
                  action="<?= url("dashboard/{{ routePrefix }}/{$item->id}") ?>">

                <?= csrf_field() ?>
                <?= method_field('PUT') ?>

                <!-- Campo: nome -->
                <div class="form-group">
                    <label for="nome">
                        Nome
                        <span style="color:var(--color-danger)">*</span>
                    </label>

                    <input type="text"
                           id="nome"
                           name="nome"
                           value="<?= e(old('nome', $item->nome ?? '')) ?>"
                           class="<?= inputClass('nome') ?>"
                           required
                           autofocus>

                    <?php if (hasError('nome')): ?>
                        <span class="form-error">
                            <?= e(error('nome')) ?>
                        </span>
                    <?php endif; ?>
                </div>

