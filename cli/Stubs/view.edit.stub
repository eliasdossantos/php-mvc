        <a href="<?= url('dashboard/{{ routePrefix }}') ?>" class="btn btn-outline btn-sm">
            ← Voltar
        </a>
        <h1 style="margin-top:12px"><?= e($title ?? 'Editar {{ ModelName }}') ?></h1>
