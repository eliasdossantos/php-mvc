<?php

namespace App\Api\Controllers;

use App\Repositories\{{ ModelName }}Repository;
use App\Api\Resources\{{ ModelName }}Resource;

/**
 * {{ ClassName }}
 * ─────────────────────────────────────────────────────────────────────────────
 * Endpoints REST de {{ ModelName }} sob /api/v1. Registre as rotas em
 * routes/api.php com o middleware ApiAuthMiddleware.
