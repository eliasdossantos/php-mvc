class {{ ClassName }} extends ApiController
{
    protected {{ ModelName }}Repository $repository;

    public function __construct()
    {
        parent::__construct();
        $this->repository = new {{ ModelName }}Repository();
    }

    /** GET /{{ routePrefix }} */
    public function index(): void
    {
        $page    = max(1, (int) $this->request->get('page', 1));
        $perPage = min(100, max(1, (int) $this->request->get('per_page', 15)));

        $result = $this->repository->paginate($perPage, $page);
        $result['data'] = {{ ModelName }}Resource::collection($result['data']);

        $this->paginated($result);
    }

    /** GET /{{ routePrefix }}/{id} */
    public function show(int $id): void
    {
        $item = $this->repository->findById($id);

        if (!$item) {
            $this->error('{{ ModelName }} não encontrado.', [], 404);
        }

        $this->success({{ ModelName }}Resource::make($item));
    }

    /** POST /{{ routePrefix }} */
